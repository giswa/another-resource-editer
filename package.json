{
  "name": "ink-resources-editor",
  "version": "1.0.0",
  "description": "A Node.js console app to list, check, and edit resources using Ink/React",
  "main": "index.js",
  "scripts": {
    "build": "babel index.js resourceStore.js --out-dir dist --extensions \".js,.jsx\"",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run serve-mock-api & npm run start",
    "serve-mock-api": "node mockApi.js"
  },
  "dependencies": {
    "connect-api-mocker": "^1.11.0",
    "ink": "^4.4.1",
    "ink-select-input": "^5.0.0",
    "ink-text-input": "^5.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@types/react": "^18.2.0",
    "express": "^5.2.1"
  }
}
